<Window x:Class="DesignOptions.Forms.PinLockReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pin &amp; Lock"
        Width="740" MinWidth="560" MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFF7F7F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Headline -->
        <TextBlock x:Name="HeadlineText" Grid.Row="0"
                   FontSize="16" FontWeight="SemiBold" Foreground="#FF1F3A5F"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubheadText" Grid.Row="1"
                   Foreground="#FF555555" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Report table -->
        <DataGrid x:Name="ReportGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                  AlternatingRowBackground="#FFF2F5F9" RowBackground="White"
                  Background="White" BorderBrush="#FFC8C8C8" BorderThickness="1"
                  RowHeight="26" MinHeight="150"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFE9EEF5"/>
                    <Setter Property="Foreground" Value="#FF1F3A5F"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Selected: bold black text instead of the system white-on-blue. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="#FFE9EEF5"/>
                        </DataTrigger>
                        <!-- Selected: light tint so the bold black cell text stays readable. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFD9E6F7"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <Style x:Key="NumberCell" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!-- Template column (not DataGridCheckBoxColumn) so one click toggles it without entering edit mode. -->
                <DataGridTemplateColumn Header="Pinned" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Pin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVis}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="Uncheck to unpin these elements when you click OK"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Auto, not "*": a star column sizes against the viewport and suppresses the horizontal scrollbar. -->
                <DataGridTextColumn Header="Element kind" Binding="{Binding Kind}" Width="Auto" MinWidth="170" IsReadOnly="True"/>
                <DataGridTextColumn Header="Found" Binding="{Binding Found}" Width="70" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Pinned now" Binding="{Binding PinnedNow}" Width="90" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Already pinned" Binding="{Binding AlreadyPinned}" Width="110" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ToLockedColumn" Header="To LOCKED" Binding="{Binding ToLocked}" Width="90" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="InLockedColumn" Header="In LOCKED" Binding="{Binding InLocked}" Width="90" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Notes -->
        <TextBlock x:Name="NotesText" Grid.Row="3"
                   Foreground="#FF555555" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <!-- Next-step instruction -->
        <Border x:Name="InstructionPanel" Grid.Row="4"
                Background="#FFFFF8E1" BorderBrush="#FFE6C86E" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,12,0,0">
            <TextBlock x:Name="InstructionText" TextWrapping="Wrap" Foreground="#FF5A4500"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
