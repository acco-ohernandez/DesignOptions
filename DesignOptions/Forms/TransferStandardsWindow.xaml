<Window x:Class="DesignOptions.Forms.TransferStandardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Project Standards"
        Width="900" Height="640" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFF7F7F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Headline -->
        <TextBlock x:Name="HeadlineText" Grid.Row="0"
                   FontSize="16" FontWeight="SemiBold" Foreground="#FF1F3A5F"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Source / target -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Copy from:" VerticalAlignment="Center" Margin="0,0,10,4" Foreground="#FF333333"/>
            <ComboBox x:Name="SourceCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" MinWidth="320" HorizontalAlignment="Left"
                      DisplayMemberPath="Title" ToolTip="The open model whose standards are copied"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Into:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF333333"/>
            <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>

        <TextBlock x:Name="SubheadText" Grid.Row="2"
                   Foreground="#FF555555" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Standards table -->
        <DataGrid x:Name="ReportGrid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0"
                  AlternatingRowBackground="#FFF2F5F9" RowBackground="White"
                  Background="White" BorderBrush="#FFC8C8C8" BorderThickness="1"
                  MinRowHeight="26" MinHeight="200"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFE9EEF5"/>
                    <Setter Property="Foreground" Value="#FF1F3A5F"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,3"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                            <Setter Property="Foreground" Value="#FF8A8A8A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Foreground" Value="#FFB00020"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFD9E6F7"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Resources>
                <Style x:Key="NumberCell" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
                <Style x:Key="WrapCell" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!-- Template column so one click toggles the box without entering edit mode. -->
                <DataGridTemplateColumn Header="Transfer" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanToggle}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Standard" Binding="{Binding Name}" Width="Auto" MinWidth="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewText}" Width="60" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="70" ElementStyle="{StaticResource NumberCell}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" MinWidth="200" ElementStyle="{StaticResource WrapCell}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Notes -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="NotesText" Foreground="#FF555555" TextWrapping="Wrap"/>
            <TextBlock x:Name="SnapshotLinkText" Margin="0,4,0,0" Visibility="Collapsed">
                <Hyperlink x:Name="SnapshotFolderLink" Click="SnapshotFolderLink_Click">Open snapshots folder</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Buttons -->
        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="CheckAllButton" Content="Check all" Width="90" Height="28" Margin="0,0,8,0" Click="CheckAllButton_Click"/>
                <Button x:Name="UncheckAllButton" Content="Uncheck all" Width="90" Height="28" Click="UncheckAllButton_Click"/>
                <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontWeight="SemiBold" Foreground="#FF1F3A5F"/>
                <Button x:Name="ExportSnapshotButton" Content="Export snapshot" Width="120" Height="28" Margin="24,0,0,0"
                        Click="ExportSnapshotButton_Click"
                        ToolTip="Writes a text inventory of the standards in the source and target models, for comparing before and after a transfer"/>
                <CheckBox x:Name="AutoSnapshotCheckBox" Content="Save before/after snapshots" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Writes one snapshot just before Transfer runs and one right after"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="TransferButton" Content="Transfer" Width="100" Height="28" Margin="0,0,8,0"
                        IsDefault="True" Click="TransferButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28"
                        IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
